---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { gaiden, getPublic } from '../../lib/plan';
export async function getStaticPaths() {
  return (await getPublic('gaiden')).map((entry) => ({ params: { no: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const n = Number(entry.id);
const g = gaiden.find((x) => x.no === n)!;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const link = (x?: typeof g): [string, string] | undefined => x && [`${base}gaiden/${String(x.no).padStart(2, '0')}/`, `外伝${x.no}`];
---
<Article title={g.title} kicker={`外伝｜外伝${n}`} blockNo={3} crumbs={[[base, 'トップ'], [`${base}gaiden/`, '外伝']]}
  prev={link(gaiden.find((x) => x.no === n - 1))} next={link(gaiden.find((x) => x.no === n + 1))} current="gaiden/">
  <Content />
</Article>
