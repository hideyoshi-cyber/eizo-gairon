---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { lessons, pad, block, themeName, getPublic } from '../../lib/plan';
export async function getStaticPaths() {
  const entries = await getPublic('lessons');
  return entries.map((entry) => ({ params: { no: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const n = Number(entry.id);
const l = lessons.find((x) => x.no === n)!;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const link = (x?: typeof l): [string, string] | undefined => x && [`${base}lessons/${pad(x.no)}/`, `第${x.no}回 ${themeName(x)}`];
---
<Article
  title={l.title}
  kicker={`${l.term}｜第${l.no}回　${themeName(l)}`}
  blockNo={block(n)}
  labels={l.labels}
  crumbs={[[base, 'トップ'], [`${base}lessons/`, '授業記録']]}
  prev={link(lessons.find((x) => x.no === n - 1))}
  next={link(lessons.find((x) => x.no === n + 1))}
  current="lessons/"
>
  <Content />
</Article>
